# Smart Kitchen AI - Environment Variables Configuration

# Backend Configuration
PROJECT_NAME="Smart Kitchen AI"
API_V1_STR="/api"
SECRET_KEY="your-super-secret-jwt-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_kitchen_ai
# For SQLite (default for instant local dev): sqlite:///./smart_kitchen.db
DATABASE_URL="sqlite:///./smart_kitchen.db"

# Expiry Notification Thresholds (in days)
EXPIRY_CRITICAL_DAYS=1
EXPIRY_WARNING_DAYS=3

# AI / LLM Configuration (Optional integration for Assistant / Recipe Generator)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="local" # options: "local", "openai", "gemini"

# Frontend Configuration (for Vite)
VITE_API_URL="http://localhost:8000/api"
